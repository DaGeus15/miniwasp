# Copia este archivo como .env. Nunca subas .env a un repositorio.

# Token generado en SonarQube (My Account -> Security), solo para el analisis.
SONAR_TOKEN=

# Opcionales
# PORT=3000
# HOST=127.0.0.1
# STUN_URLS=stun:stun.cloudflare.com:3478

# Bucket compatible con S3 para los adjuntos (en Railway: Railway Buckets). Los archivos se suben
# ya cifrados. Las cuatro primeras van juntas; sin ninguna, los adjuntos quedan en memoria (solo
# desarrollo). Con NODE_ENV=production (la imagen Docker lo define) el servidor no arranca sin ellas.
# Las credenciales son secretos: en produccion se configuran en la plataforma, no aqui.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Region del bucket; vacia equivale a "auto".
# S3_REGION=
# Solo "true" lo activa: URLs con el bucket en la ruta, si el proveedor lo exige.
# S3_FORCE_PATH_STYLE=

# Capacidad (enteros positivos; vacias usan el valor por defecto indicado en docs/operations.md).
# Conexiones WebSocket simultaneas en todo el servidor.
# MAX_CONNECTIONS=
# Sesiones abiertas a la vez (cada persona conectada tiene una).
# MAX_SESSIONS=
# Salas abiertas a la vez.
# MAX_ROOMS=
# Subidas de archivos procesandose a la vez.
# UPLOAD_CONCURRENCY=
# Hilos de moderacion de imagenes; cada uno carga su propia copia del modelo.
# IMAGE_MODERATION_WORKERS=
